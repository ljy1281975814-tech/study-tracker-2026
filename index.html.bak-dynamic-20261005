<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex,nofollow,noarchive">
<title>学习追踪看板</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    background: #f5f6f8; color: #2b2f36; line-height: 1.6; padding: 24px 16px 48px;
  }
  .wrap { max-width: 960px; margin: 0 auto; }
  .header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin-bottom: 18px; }
  .header h1 { font-size: 26px; font-weight: 700; }
  .header .sub { font-size: 14px; color: #6b7280; }
  .header .upt { margin-left: auto; font-size: 12px; color: #9ca3af; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 20px; }
  .card { background: #fff; border-radius: 12px; padding: 16px 18px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
  .card .label { font-size: 12px; color: #9ca3af; margin-bottom: 4px; }
  .card .value { font-size: 30px; font-weight: 700; color: #d93025; line-height: 1.2; }
  .card .value small { font-size: 14px; font-weight: 400; color: #6b7280; }
  .card.plain .value { color: #1f2937; font-size: 22px; }
  .card .note { font-size: 12px; color: #6b7280; margin-top: 4px; }

  .panel { background: #fff; border-radius: 12px; padding: 18px 20px; box-shadow: 0 1px 3px rgba(0,0,0,.06); margin-bottom: 16px; }
  .panel h2 { font-size: 16px; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
  .panel h2 .tag { font-size: 11px; font-weight: 400; color: #6b7280; background: #f3f4f6; border-radius: 99px; padding: 2px 10px; }

  /* 今日速览 */
  .today-panel { background: linear-gradient(135deg, #1f2937 0%, #374151 100%); color: #fff; border: none; }
  .today-panel .task-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
  .today-panel .task-item { display: flex; gap: 8px; align-items: flex-start; background: rgba(255,255,255,.1); border-radius: 8px; padding: 10px; }
  .today-panel .task-item .emoji { font-size: 20px; }
  .today-panel .task-item .title { font-weight: 600; font-size: 14px; }
  .today-panel .task-item .desc { font-size: 12px; opacity: .7; }

  /* 阶段时间轴 */
  .stages { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .stage { border-radius: 10px; padding: 10px 12px; background: #f8f9fa; border: 1.5px solid transparent; }
  .stage .s-name { font-size: 13px; font-weight: 700; }
  .stage .s-date { font-size: 11px; color: #9ca3af; }
  .stage.now { background: #fef2f2; border-color: #d93025; }
  .stage.now .s-name { color: #d93025; }
  .stage .s-mark { font-size: 11px; margin-top: 2px; color: #d93025; font-weight: 700; }
  @media (max-width: 640px) { .stages { grid-template-columns: repeat(2, 1fr); } }

  /* 科目进度条 */
  .subj { margin-bottom: 14px; }
  .subj:last-child { margin-bottom: 0; }
  .subj .row1 { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 4px; }
  .subj .name { font-weight: 600; }
  .subj .name .st { font-weight: 400; font-size: 12px; color: #9ca3af; margin-left: 8px; }
  .subj .pct { font-weight: 700; color: #374151; }
  .subj .bar { height: 8px; border-radius: 4px; background: #e5e7eb; overflow: hidden; }
  .subj .bar > div { height: 100%; border-radius: 4px; background: #4b5563; transition: width .4s; }

  /* 可视化区 */
  .viz-row { display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-start; }
  .viz-box { flex: 1 1 300px; min-width: 280px; }
  .viz-box h3 { font-size: 13px; font-weight: 600; color: #6b7280; margin-bottom: 8px; }
  canvas#radar { display: block; width: 100%; max-width: 340px; margin: 0 auto; }

  /* 今日任务 */
  .today-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; }
  @media (max-width: 720px) { .today-grid { grid-template-columns: 1fr; } }
  .task { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #f3f4f6; }
  .task:last-child { border-bottom: none; padding-bottom: 0; }
  .task .icon { font-size: 22px; line-height: 1; }
  .task .t-title { font-weight: 600; font-size: 14px; margin-bottom: 2px; }
  .task .t-desc { font-size: 12px; color: #6b7280; }
  .tomorrow { background: #f9fafb; border-radius: 10px; padding: 14px 16px; }
  .tomorrow .t-title { font-weight: 600; font-size: 13px; margin-bottom: 8px; color: #374151; }
  .tomorrow ul { list-style: none; }
  .tomorrow li { font-size: 12px; color: #6b7280; padding: 4px 0; border-bottom: 1px solid #e5e7eb; }
  .tomorrow li:last-child { border-bottom: none; }

  /* 汇报流程 */
  .flow { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 640px) { .flow { grid-template-columns: 1fr; } }
  .steps { list-style: none; }
  .steps li { display: flex; gap: 10px; margin-bottom: 10px; font-size: 13px; }
  .steps .num { flex-shrink: 0; width: 20px; height: 20px; background: #d93025; color: #fff; border-radius: 50%; text-align: center; line-height: 20px; font-size: 11px; font-weight: 700; margin-top: 2px; }

  .footer { margin-top: 24px; font-size: 11px; color: #9ca3af; text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <!-- 顶部 -->
  <div class="header">
    <h1>学习追踪看板</h1>
    <span class="sub">硕士备考 · 数据科学方向</span>
    <span class="upt">快照时间：2026-10-04 · 周刷新/汇报后更新</span>
  </div>

  <!-- 今日速览 -->
  <div class="panel today-panel">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px;">
      <div>
        <div style="font-size: 11px; opacity: .7; margin-bottom: 4px;">2026-10-04 · 周六 · 阶段一 首周 Day 4</div>
        <div style="font-size: 28px; font-weight: 700;">距考试 <span style="color: #fbbf24;">76</span> <small style="font-size: 16px; opacity: .8;">天</small></div>
