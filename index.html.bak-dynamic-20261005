  </div>

  <!-- 科目进度 + 雷达图 -->
  <div class="panel">
    <h2>科目进度 <span class="tag">自评 · 汇报后更新</span></h2>
    <div class="viz-row">
      <div style="flex: 1.2 1 300px;">
        <div class="subj">
          <div class="row1">
            <span class="name">社会心理学<span class="st">已点火 · 第 1 讲进行中</span></span>
            <span class="pct">3%</span>
          </div>
          <div class="bar"><div style="width:3%; background:#d93025;"></div></div>
        </div>
        <div class="subj">
          <div class="row1">
            <span class="name">普心 / 心理学导论<span class="st">强化 1-13 章完，14-16 章 18% 断点</span></span>
            <span class="pct">80%</span>
          </div>
          <div class="bar"><div style="width:80%; background:#1d4ed8;"></div></div>
        </div>
        <div class="subj">
          <div class="row1">
            <span class="name">研究方法（统计/测量/实验）<span class="st">实验营完，刷题课 1/2/3 未学</span></span>
