        <div class="s-name">阶段一 · 十月攻坚</div>
        <div class="s-date">10/1 – 10/31（国庆周 + 主科二轮）</div>
        <div class="s-mark">◀ 现在</div>
      </div>
      <div class="stage">
        <div class="s-name">阶段二 · 十一月模考</div>
        <div class="s-date">11/1 – 11/30（背诵 + 主观题）</div>
      </div>
      <div class="stage">
        <div class="s-name">阶段三 · 十二月冲刺</div>
