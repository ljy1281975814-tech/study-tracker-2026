#!/bin/sh
# PREPUSH_PREFLIGHT_20261112
# 推送前：若本次改动涉及 quiz/index.html，则强制跑「交付前模拟自检」
# 建立原因（客户 2026-11-12 09:50）：「交付之前不能先自己模拟打开检查一下…再交付么」
set -e
ZERO=0000000000000000000000000000000000000000
CHANGED=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "$ZERO" ]; then
    CHANGED=1
  else
    if git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null | grep -q '^quiz/index.html$'; then
      CHANGED=1
    fi
  fi
done

if [ "$CHANGED" = "1" ]; then
  echo ""
  echo "===== 交付前模拟自检（quiz/index.html 有改动，强制运行）====="
  if command -v node >/dev/null 2>&1; then
    if node "C:/Users/42989/WorkBuddy/347备考/_运行资产/_quiz_preflight.js"; then
      echo "===== 自检通过，继续推送 ====="
    else
      echo ""
      echo "🔴 交付前模拟自检未通过，拒绝推送。"
      echo "   修好后重跑： node C:/Users/42989/WorkBuddy/347备考/_运行资产/_quiz_preflight.js"
      exit 1
    fi
  else
    echo "⚠ 未找到 node，跳过自检（不推荐）"
  fi
  echo ""
fi
exit 0
